# --- Aplicação ---
PORT=3000
NODE_ENV=development
# URL pública usada nos links dos e-mails (sem barra no final)
APP_URL=http://localhost:3000
# Validade do convite em dias
CONVITE_VALIDADE_DIAS=7
# Validade da sessão em horas
SESSAO_HORAS=8

# --- E-mail ---
# console  = imprime o e-mail no terminal (desenvolvimento)
# brevo    = envia de verdade pela API HTTP do Brevo
EMAIL_MODO=console
BREVO_API_KEY=
EMAIL_REMETENTE=nao-responda@seudominio.com
EMAIL_REMETENTE_NOME=LumaSat

# --- Primeiro administrador (usado só por scripts/criar-admin.js) ---
ADMIN_EMAIL=admin@gmail.com
ADMIN_SENHA=123456
ADMIN_NOME=Administrador